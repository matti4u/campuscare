# =========================================================
# LOAD REQUESTS
# =========================================================

def load_requests():

    for item in request_table.get_children():
        request_table.delete(item)

    try:

        conn = connect_db()
        cursor = conn.cursor()

        cursor.execute(
            """ SELECT request_id, requester_name, category, location, description, priority, approval_status, status, date_reported FROM maintenance_requests ORDER BY request_id DESC; """
        )

        rows = cursor.fetchall()

        cursor.close()
        conn.close()

        for row in rows:

            date_text = ""

            if row[8]:
                date_text = row[8].strftime(
                    "%Y-%m-%d %H:%M"
                )

            request_table.insert(
                "",
                tk.END,
                values=(
                    row[0],
                    row[1],
                    row[2],
                    row[3],
                    row[4],
                    row[5],
                    row[6],
                    row[7],
                    date_text
                )
            )

    except Exception as e:

        messagebox.showerror(
            "Database Error",
            f"Could not load requests:\n\n{e}"
        )


# =========================================================
# UPDATE APPROVAL
# =========================================================

def update_approval():

    selected = request_table.selection()
    if not selected:
        messagebox.showwarning(
            "No Request Selected", "Please select a request first."
        )
        return

    selected_item = request_table.item(selected[0])
    request_id = selected_item["values"][0]
    new_approval = approval_combo.get().strip()

    if not new_approval:
        messagebox.showwarning(
            "No Approval Status", "Please select an approval status."
        )
        return

    rejection_reason = None
    if new_approval.lower() == "rejected":
        rejection_reason = simpledialog.askstring(
            "Rejection Reason",
            f"Enter the reason for rejecting request #{request_id}:",
            parent=window
        )
        if rejection_reason is None:
            return
        rejection_reason = rejection_reason.strip()
        if not rejection_reason:
            messagebox.showwarning(
                "Reason Required",
                "Please enter a reason before rejecting this request."
            )
            return

    try:
        conn = connect_db()
        cursor = conn.cursor()
        cursor.execute(
            """ UPDATE maintenance_requests SET approval_status = %s, rejection_reason = %s WHERE request_id = %s; """,
            (new_approval, rejection_reason, request_id)
        )
        conn.commit()
        cursor.close()
        conn.close()

        success_text = (
            f"Request #{request_id} approval has been updated to:\n\n"
            f"{new_approval}"
        )
        if new_approval.lower() == "rejected":
            success_text += (
                "\n\nThe rejection reason is saved and will appear "
                "when the student checks the request status."
            )
        messagebox.showinfo("Success", success_text)
        load_requests()

    except Exception as e:
        messagebox.showerror(
            "Database Error", f"Could not update approval:\n\n{e}"
        )


# =========================================================
# UPDATE MAINTENANCE STATUS
# =========================================================

def update_status():

    selected = request_table.selection()

    if not selected:

        messagebox.showwarning(
            "No Request Selected",
            "Please select a request first."
        )

        return

    selected_item = request_table.item(selected[0])

    request_id = selected_item["values"][0]

    new_status = status_combo.get()

    if not new_status:

        messagebox.showwarning(
            "No Status",
            "Please select a maintenance status."
        )

        return

    try:

        conn = connect_db()
        cursor = conn.cursor()

        cursor.execute(
            """ UPDATE maintenance_requests SET status = %s WHERE request_id = %s; """,
            (
                new_status,
                request_id
            )
        )

        conn.commit()

        cursor.close()
        conn.close()

        messagebox.showinfo(
            "Success",
            f"Request #{request_id} maintenance status has been updated to:\n\n"
            f"{new_status}"
        )

        load_requests()

    except Exception as e:

        messagebox.showerror(
            "Database Error",
            f"Could not update status:\n\n{e}"
        )


# =========================================================
# SEARCH REQUESTS
# =========================================================

def search_requests():

    search_text = search_entry.get().strip()

    for item in request_table.get_children():
        request_table.delete(item)

    try:

        conn = connect_db()
        cursor = conn.cursor()

        cursor.execute(
            """ SELECT request_id, requester_name, category, location, description, priority, approval_status, status, date_reported FROM maintenance_requests WHERE CAST(request_id AS TEXT) ILIKE %s OR requester_name ILIKE %s OR category ILIKE %s OR location ILIKE %s OR approval_status ILIKE %s OR status ILIKE %s ORDER BY request_id DESC; """,
            (
                "%" + search_text + "%",
                "%" + search_text + "%",
                "%" + search_text + "%",
                "%" + search_text + "%",
                "%" + search_text + "%",
                "%" + search_text + "%"
            )
        )

        rows = cursor.fetchall()

        cursor.close()
        conn.close()

        for row in rows:

            date_text = ""

            if row[8]:
                date_text = row[8].strftime(
                    "%Y-%m-%d %H:%M"
                )

            request_table.insert(
                "",
                tk.END,
                values=(
                    row[0],
                    row[1],
                    row[2],
                    row[3],
                    row[4],
                    row[5],
                    row[6],
                    row[7],
                    date_text
                )
            )

    except Exception as e:

        messagebox.showerror(
            "Database Error",
            f"Search failed:\n\n{e}"
        )


